# Ambiente de producao - substitua todos os placeholders fora do repositorio
APP_ENV=prod
FRONTEND_PUBLIC_URL=https://classificador.interno
API_PUBLIC_URL=https://classificador.interno/api
CORS_ALLOWED_ORIGINS=https://classificador.interno

# PostgreSQL exclusivo e privado de producao
POSTGRES_DB=classificador_prod
POSTGRES_USER=classificador_prod
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_PROD
DATABASE_URL=postgresql+psycopg://classificador_prod:CHANGE_ME_POSTGRES_PASSWORD_PROD@postgres:5432/classificador_prod

# API
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN_PROD
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_PROD_32_CHARS_MIN
JWT_ALGORITHM=HS256

# Frontend
VITE_APP_ENV=prod
VITE_FRONTEND_PUBLIC_URL=https://classificador.interno
VITE_API_BASE_URL=/api
