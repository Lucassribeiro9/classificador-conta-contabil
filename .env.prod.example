# Ambiente de producao - substitua todos os placeholders fora do repositorio
APP_ENV=prod
FRONTEND_PUBLIC_URL=https://classificador.interno
API_PUBLIC_URL=https://classificador.interno/api
CORS_ALLOWED_ORIGINS=https://classificador.interno

# PostgreSQL exclusivo e privado de producao
POSTGRES_DB_PROD=classificador_prod
POSTGRES_USER_PROD=classificador_prod
POSTGRES_PASSWORD_PROD=CHANGE_ME_POSTGRES_PASSWORD_PROD
DATABASE_URL_PROD=postgresql+psycopg://classificador_prod:CHANGE_ME_POSTGRES_PASSWORD_PROD@postgres:5432/classificador_prod

# API
ADMIN_TOKEN_PROD=CHANGE_ME_ADMIN_TOKEN_PROD
JWT_SECRET_KEY_PROD=CHANGE_ME_JWT_SECRET_KEY_PROD_32_CHARS_MIN
JWT_ALGORITHM_PROD=HS256
SERVICE_CREDENTIAL_SECRET_PROD=CHANGE_ME_SERVICE_CREDENTIAL_SECRET_PROD_32_CHARS_MIN
TECHNICAL_LOG_DIR_PROD=/app/data/logs

# Importacao assincrona do Razao
RAZAO_UPLOAD_MAX_BYTES_PROD=50000000
RAZAO_STORAGE_MIN_FREE_BYTES_PROD=5000000000
RAZAO_STORAGE_MIN_FREE_RATIO_PROD=0.15
RAZAO_FAILED_RETENTION_SECONDS_PROD=86400
RAZAO_IMPORT_BLOCK_SIZE_PROD=1000
RAZAO_WORKER_CONCURRENCY_PROD=1
RAZAO_HEARTBEAT_SECONDS_PROD=30
RAZAO_LEASE_SECONDS_PROD=600
RAZAO_POLL_INTERVAL_SECONDS_PROD=3

# Frontend
VITE_APP_ENV=prod
VITE_FRONTEND_PUBLIC_URL=https://classificador.interno
VITE_API_BASE_URL=/api
