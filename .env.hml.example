# Ambiente de homologacao - substitua todos os placeholders fora do repositorio
APP_ENV=hml
FRONTEND_PUBLIC_URL=https://classificador-hml.interno
API_PUBLIC_URL=https://classificador-hml.interno/api
CORS_ALLOWED_ORIGINS_HML=https://classificador-hml.interno

# PostgreSQL exclusivo e privado de homologacao
POSTGRES_DB_HML=classificador_hml
POSTGRES_USER_HML=classificador_hml
POSTGRES_PASSWORD_HML=CHANGE_ME_POSTGRES_PASSWORD_HML
DATABASE_URL_HML=postgresql+psycopg://classificador_hml:CHANGE_ME_POSTGRES_PASSWORD_HML@postgres:5432/classificador_hml

# API
ADMIN_TOKEN_HML=CHANGE_ME_ADMIN_TOKEN_HML
JWT_SECRET_KEY_HML=CHANGE_ME_JWT_SECRET_KEY_HML_32_CHARS_MIN
JWT_ALGORITHM_HML=HS256
SERVICE_CREDENTIAL_SECRET_HML=CHANGE_ME_SERVICE_CREDENTIAL_SECRET_HML_32_CHARS_MIN

# Importacao assincrona do Razao
RAZAO_UPLOAD_MAX_BYTES_HML=50000000
RAZAO_STORAGE_MIN_FREE_BYTES_HML=5000000000
RAZAO_STORAGE_MIN_FREE_RATIO_HML=0.15
RAZAO_FAILED_RETENTION_SECONDS_HML=86400
RAZAO_IMPORT_BLOCK_SIZE_HML=1000
RAZAO_WORKER_CONCURRENCY_HML=1
RAZAO_HEARTBEAT_SECONDS_HML=30
RAZAO_LEASE_SECONDS_HML=600
RAZAO_POLL_INTERVAL_SECONDS_HML=3

# Frontend
VITE_APP_ENV=hml
VITE_FRONTEND_PUBLIC_URL=https://classificador-hml.interno
VITE_API_BASE_URL=/api

# Certificado e chave fornecidos pela CA interna no host; nao versionar
HML_TLS_CERT_PATH=/etc/classificador/certs/classificador-hml.crt
HML_TLS_KEY_PATH=/etc/classificador/certs/classificador-hml.key
