# Ambiente de homologacao - substitua todos os placeholders fora do repositorio
APP_ENV=hml
FRONTEND_PUBLIC_URL=https://classificador-hml.interno
API_PUBLIC_URL=https://classificador-hml.interno/api
CORS_ALLOWED_ORIGINS=https://classificador-hml.interno

# PostgreSQL exclusivo e privado de homologacao
POSTGRES_DB=classificador_hml
POSTGRES_USER=classificador_hml
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_HML
DATABASE_URL=postgresql+psycopg://classificador_hml:CHANGE_ME_POSTGRES_PASSWORD_HML@postgres:5432/classificador_hml

# API
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN_HML
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_HML_32_CHARS_MIN
JWT_ALGORITHM=HS256

# Frontend
VITE_APP_ENV=hml
VITE_FRONTEND_PUBLIC_URL=https://classificador-hml.interno
VITE_API_BASE_URL=/api
