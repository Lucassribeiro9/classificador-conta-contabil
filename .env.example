# Ambiente
APP_ENV=dev
FRONTEND_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL local para Docker Compose
POSTGRES_DB=classificador_dev
POSTGRES_USER=classificador_dev
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_DEV
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# API
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN_DEV
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_32_CHARS_MIN
JWT_ALGORITHM=HS256
SERVICE_CREDENTIAL_SECRET=CHANGE_ME_SERVICE_CREDENTIAL_SECRET_32_CHARS_MIN

# n8n/ngrok local
WEBHOOK_URL=http://localhost:5678/
NGROK_AUTH_TOKEN=
